# Copie este arquivo para .env e ajuste os valores.
# O arquivo .env NAO deve ser versionado (ja esta no .gitignore).

# Django
DJANGO_SECRET_KEY=troque-por-uma-chave-secreta-longa-e-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Banco de dados MySQL (banco em branco)
DB_NAME=gestao_frotas
DB_USER=root
