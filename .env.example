# Copie este arquivo para .env e ajuste os valores.
# O arquivo .env NAO deve ser versionado (ja esta no .gitignore).

# Django
DJANGO_SECRET_KEY=troque-por-uma-chave-secreta-longa-e-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Em producao (HTTPS), liste o dominio para o CSRF aceitar os formularios.
# Ex.: https://meuapp.up.railway.app
DJANGO_CSRF_TRUSTED_ORIGINS=

# Banco de dados PostgreSQL (banco em branco) - uso local
DB_NAME=gestao_frotas
DB_USER=postgres
DB_PASSWORD=sua_senha_do_postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Em producao (ex.: Railway) basta definir DATABASE_URL; quando presente,
# ela tem prioridade sobre as variaveis DB_* acima.
# DATABASE_URL=postgresql://usuario:senha@host:porta/banco

# ---- Armazenamento de arquivos (uploads) ----
# Em producao o disco e efemero: use um storage S3 (AWS, Cloudflare R2, MinIO).
# USE_S3=True
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=auto
# AWS_S3_ENDPOINT_URL=            # ex.: https://<accountid>.r2.cloudflarestorage.com

# ---- E-mail (recuperacao de senha, convites, alertas) ----
# Sem EMAIL_HOST os e-mails vao para o console (dev).
# EMAIL_HOST=smtp.seuprovedor.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Gestão de Frotas <no-reply@seudominio.com>

# ---- Monitoramento de erros (Sentry) ----
# SENTRY_DSN=https://...ingest.sentry.io/...
